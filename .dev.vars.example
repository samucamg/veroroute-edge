# ==============================================================================
# VeroRoute Edge - Local Environment Variables (.dev.vars)
# ==============================================================================
# 💡 NOTA IMPORTANTE:
# TODAS as chaves de API e segredos são 100% OPCIONAIS!
# Você NÃO precisa preencher tudo. Basta configurar UMA ÚNICA chave que você
# possua (ex: só GEMINI_API_KEYS ou só GROQ_API_KEYS).
# Se não preencher nenhuma, o gateway opera via Cloudflare Workers AI nativo ($0).
# ==============================================================================

# Token mestre para autenticar seus clientes no gateway (Bearer token)
# Deixe vazio se quiser acesso livre sem autenticação
AUTH_TOKEN=seu-token-mestre-privado

# --- Provedores LLM (Preencha apenas o que for usar) ---
# Dica: aceite múltiplas chaves separadas por vírgula para round-robin automático
GEMINI_API_KEYS=
GROQ_API_KEYS=
CEREBRAS_API_KEYS=
OPENAI_API_KEYS=

# --- Busca Web Paga Opcional ---
# Deixe vazio para usar DuckDuckGo HTML gratuito ($0 sem chave) ou SearXNG
TAVILY_API_KEYS=
