{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veroroute-edge",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],

  // Workers AI - Provedor nativo serverless sem chaves externas (10.000 neurônios/dia grátis)
  "ai": {
    "binding": "AI"
  },

  // KV Namespaces para persistência de tokens, cache de rate limit e chaves
  "kv_namespaces": [
    {
      "binding": "OMNI_CACHE",
      "id": "OMNI_CACHE_ID"
    },
    {
      "binding": "OMNI_KEYS",
      "id": "OMNI_KEYS_ID"
    }
  ],

  // Variáveis de ambiente padrão
  "vars": {
    "DEFAULT_ROUTING_STRATEGY": "priority",
    "DEFAULT_OUTPUT_STYLE": "none",
    "SEARXNG_URL": "", // Insira sua instância SearXNG própria aqui ou configure no .dev.vars
    "ENABLE_MODALITY_BRIDGE": "true",
    "ENABLE_CONTEXT_COMPRESSION": "true",
    "ENABLE_JINA_READER": "true",
    "ENABLE_MCP_SERVER": "true",
    "ENABLE_QUOTA_SHARING": "true",
    "MAX_RETRIES": "3",
    "RETRY_DELAY_MS": "1000"
  },

  "observability": {
    "enabled": true
  }
}
